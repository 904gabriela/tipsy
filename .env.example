# Copy this file to `.env` and paste your real keys there.
# Never put real credentials in this template.
# `.env` is ignored by git.

# From https://openrouter.ai/keys — this is the only one needed to start.
OPENROUTER_API_KEY=

# Optional. Only if you later want to talk to these directly instead of
# through OpenRouter.
ANTHROPIC_API_KEY=
